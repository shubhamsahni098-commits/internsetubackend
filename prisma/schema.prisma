generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
}

model Student {
  id       String @id @default(uuid())
  fullName String
  email    String @unique
  phone    String?
  password String

  location          String?
  education         String?
  preferredRole     String?
  preferredLocation String?
  skills            Json?
  preferences       Json?

  applications Application[]
  feedback     Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}

model Company {
  id            String  @id @default(uuid())
  companyName   String
  officialEmail String  @unique
  password      String
  phone         String?
  website       String?
  industry      String?
  location      String?
  isVerified    Boolean @default(false)

  internships Internship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model Internship {
  id              String   @id @default(uuid())
  title           String
  description     String   @db.Text
  domain          String
  skills          Json
  location        String
  internshipType  String
  workMode        WorkMode
  stipend         String?
  duration        String
  eligibility     String
  deadline        DateTime?
  applicationLink String?
  isActive        Boolean  @default(true)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  applications Application[]
  feedback     Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([domain])
  @@index([location])
  @@map("internships")
}

model Application {
  id     String            @id @default(uuid())
  status ApplicationStatus @default(APPLIED)

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  internshipId String

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, internshipId])
  @@index([internshipId])
  @@map("applications")
}

model Feedback {
  id String @id @default(uuid())

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   String

  internship  Internship  @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  internshipId String

  feedback String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, internshipId])
  @@index([studentId])
  @@index([internshipId])
  @@map("feedback")
}